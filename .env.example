# Reference values for your shell environment; the app does not auto-load .env.
QUANT_MONITOR_HOST=127.0.0.1
QUANT_MONITOR_PORT=8000
QUANT_MONITOR_DB_PATH=data/quant_monitor_asharehub.db
QUANT_MONITOR_DATA_PROVIDER=asharehub
QUANT_MONITOR_POLL_INTERVAL=60
QUANT_MONITOR_LOG_LEVEL=INFO
# Required only when QUANT_MONITOR_DATA_PROVIDER=asharehub. Never commit a real key.
QUANT_MONITOR_ASHAREHUB_API_KEY=
QUANT_MONITOR_ASHAREHUB_QUOTE_CACHE_SECONDS=300
QUANT_MONITOR_ASHAREHUB_BARS_CACHE_SECONDS=86400
QUANT_MONITOR_ASHAREHUB_INSTRUMENTS_CACHE_SECONDS=604800
QUANT_MONITOR_ASHAREHUB_RETRIES=0
QUANT_MONITOR_ASHAREHUB_DAILY_SOFT_LIMIT=90
QUANT_MONITOR_ASHAREHUB_HISTORY_RESERVE_REQUESTS=10
QUANT_MONITOR_ASHAREHUB_HISTORY_REFRESH_SECONDS=900
# Required only when QUANT_MONITOR_DATA_PROVIDER=alltick. Never commit a real token.
QUANT_MONITOR_ALLTICK_TOKEN=
QUANT_MONITOR_ALLTICK_HTTP_MIN_INTERVAL_SECONDS=10
QUANT_MONITOR_ALLTICK_QUOTE_CACHE_SECONDS=10
QUANT_MONITOR_ALLTICK_BARS_CACHE_SECONDS=120
QUANT_MONITOR_ALLTICK_RETRIES=2
QUANT_MONITOR_ALLTICK_BATCH_SIZE=5
QUANT_MONITOR_ALLTICK_KLINE_BATCH_SIZE=10
QUANT_MONITOR_ALLTICK_USE_WEBSOCKET=true
QUANT_MONITOR_ALLTICK_USE_ORDER_BOOK=true
QUANT_MONITOR_ALLTICK_BOOTSTRAP_DAILY_REFERENCE=true
QUANT_MONITOR_ALLTICK_FETCH_STATIC_INFO=true
QUANT_MONITOR_ALLTICK_WEBSOCKET_SYMBOL_LIMIT=5
QUANT_MONITOR_ALLTICK_WEBSOCKET_SUBSCRIPTION_GAP_SECONDS=1.05
QUANT_MONITOR_ALLTICK_PERMISSION_RETRY_SECONDS=300
QUANT_MONITOR_AKSHARE_QUOTE_CACHE_SECONDS=15
QUANT_MONITOR_AKSHARE_BARS_CACHE_SECONDS=30
QUANT_MONITOR_AKSHARE_RETRIES=2
QUANT_MONITOR_AKSHARE_RETRY_BACKOFF_SECONDS=0.5
QUANT_MONITOR_AKSHARE_STRICT_SYMBOLS=true
QUANT_MONITOR_AKSHARE_USE_SPOT_FALLBACK=false
